// Prisma schema — Catering Management System
// DB: PostgreSQL 16, managed by Prisma ORM
// Conventions: snake_case in DB, camelCase in JS (Prisma maps automatically)
// Money: all amounts stored as Int (agorot). No floats.
// IDs: cuid() — matches the API contract (§1.1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — kept in sync with packages/shared/src/enums.ts
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  OFFICE
  KITCHEN_MANAGER
  KITCHEN_STAFF
  DRIVER
}

enum DishCategory {
  STARTER
  MAIN
  SIDE
  SALAD
  DESSERT
  DRINK
}

enum Kashrut {
  MEAT
  DAIRY
  PARVE
}

enum SaleUnit {
  PORTION
  TRAY
  KG
  UNIT
}

enum OrderStatus {
  DRAFT
  QUOTE_SENT
  CONFIRMED
  IN_PRODUCTION
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CLOSED
  LOST
  CANCELLED
}

enum EventType {
  CELEBRATION
  BRIT
  BAR_MITZVAH
  CORPORATE
  SHABBAT
  OTHER
}

enum ServiceType {
  DELIVERY
  DELIVERY_AND_SERVING
  PICKUP
}

enum DiscountType {
  NONE
  FIXED
  PERCENT
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  CREDIT_CARD
  NET_30
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum KitchenTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  PACKED
}

enum StockMoveType {
  IN
  OUT
  ADJUST
  WASTE
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  EN_ROUTE
  DELIVERED
}


// ─────────────────────────────────────────────────────────────────────────────
// User model (Week 1 — Auth & Users module)
// Fields: id, email, passwordHash, role, active
// Extra useful fields added now so seed/auth work correctly.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  active       Boolean  @default(true)
  phone        String?

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Password reset
  resetToken          String?   @unique @map("reset_token")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Dish model (Phase 4 — Dishes module)
// Fields: id, version, name, category, kashrut, unit, portionsPerUnit, price,
//         imageUrl, allergens, active, recipe, cost, timestamps
// ─────────────────────────────────────────────────────────────────────────────

model Dish {
  id              String       @id @default(cuid())
  version         Int          @default(1)
  name            String
  category        DishCategory
  kashrut         Kashrut
  unit            SaleUnit     @default(PORTION)
  portionsPerUnit Float        @default(1) @map("portions_per_unit")
  price           Int          // In agorot
  imageUrl        String?      @map("image_url")
  allergens       String[]     @default([])
  active          Boolean      @default(true)
  recipe          Json         @default("[]") // Recipe lines: [{ ingredientId, ingredientName, unit, qtyPerPortion }]
  cost            Json?        // Cost info: { perPortion, marginPercent }

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dishes")
}

// ─────────────────────────────────────────────────────────────────────────────
// Order model (Phase 5 — Orders module)
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id                 String      @id @default(cuid())
  number             Int         @default(autoincrement())
  status             OrderStatus @default(DRAFT)
  version            Int         @default(1)
  customerId         String      @map("customer_id")
  customer           Json        // { id, name, phone }
  event              Json        // Event: { id, title, type, startsAt, address, lat, lng, guests, kashrut, serviceType, notes }
  items              Json        @default("[]") // OrderItem[]: [{ id, dishId, dishName, category, unit, qty, unitPrice, priceOverridden, lineTotal, notes }]
  services           Json        @default("[]") // OrderService[]: [{ id, serviceId, name, qty, unitPrice, lineTotal }]
  pricing            Json        // Pricing: { discountType, discountValue, vatPercent, pricesIncludeVat, depositPercent, paymentTerms, validUntil }
  totals             Json        // Totals: { subtotal, discount, vat, total, deposit, paid, balance, perGuest }
  allowedTransitions OrderStatus[] @map("allowed_transitions")
  isLocked           Boolean     @default(false) @map("is_locked")
  latestQuoteVersion Int?        @map("latest_quote_version")
  publicQuoteToken   String?     @unique @map("public_quote_token")
  deliveryId         String?     @map("delivery_id")
  createdById        String      @map("created_by_id")
  createdBy          Json        // { id, name }

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("orders")
}

// ─────────────────────────────────────────────────────────────────────────────
// Quote model (Phase 6 — Public Quotes portal & Quotes management)
// ─────────────────────────────────────────────────────────────────────────────

model Quote {
  id            String    @id @default(cuid())
  orderId       String    @map("order_id")
  version       Int       @default(1)
  token         String    @unique @default(cuid())
  signerName    String?   @map("signer_name")
  signaturePng  String?   @map("signature_png")
  approvedAt    DateTime? @map("approved_at")
  changeRequest String?   @map("change_request")
  pdfUrl        String?   @map("pdf_url")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("quotes")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payment model (Phase 6 — Payments module)
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id         String        @id @default(cuid())
  orderId    String        @map("order_id")
  amount     Int           // In agorot
  method     PaymentMethod
  status     PaymentStatus @default(SUCCEEDED)
  reference  String?
  receiptUrl String?       @map("receipt_url")

  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Ingredient model (Phase 8 — Inventory & Kitchen module)
// ─────────────────────────────────────────────────────────────────────────────

model Ingredient {
  id           String   @id @default(cuid())
  name         String
  category     String?
  unit         String   @default("KG")
  currentStock Float    @default(0) @map("current_stock")
  minStock     Float    @default(0) @map("min_stock")
  costPerUnit  Int      @map("cost_per_unit") // In agorot
  supplierId   String?  @map("supplier_id")
  supplierName String?  @map("supplier_name")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("ingredients")
}

// ─────────────────────────────────────────────────────────────────────────────
// StockMove model (Phase 8 — Inventory & Kitchen module)
// ─────────────────────────────────────────────────────────────────────────────

model StockMove {
  id             String        @id @default(cuid())
  ingredientId   String        @map("ingredient_id")
  ingredientName String?       @map("ingredient_name")
  type           StockMoveType
  qty            Float
  reason         String
  createdById    String?       @map("created_by_id")
  createdByName  String?       @map("created_by_name")

  createdAt      DateTime      @default(now()) @map("created_at")

  @@map("stock_moves")
}

// ─────────────────────────────────────────────────────────────────────────────
// Supplier model (Phase 8 — Purchasing module)
// ─────────────────────────────────────────────────────────────────────────────

model Supplier {
  id           String   @id @default(cuid())
  name         String
  contactName  String?  @map("contact_name")
  phone        String
  email        String?
  categories   String[] @default([])
  leadTimeDays Int      @default(1) @map("lead_time_days")
  notes        String?

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
}

// ─────────────────────────────────────────────────────────────────────────────
// PurchaseOrder & PurchaseOrderLine models (Phase 8 — Purchasing module)
// ─────────────────────────────────────────────────────────────────────────────

model PurchaseOrder {
  id                   String              @id @default(cuid())
  number               Int                 @default(autoincrement())
  supplierId           String              @map("supplier_id")
  supplierName         String              @map("supplier_name")
  status               PurchaseOrderStatus @default(DRAFT)
  lines                PurchaseOrderLine[]
  total                Int                 @default(0) // In agorot
  expectedDeliveryDate String?             @map("expected_delivery_date") // YYYY-MM-DD
  sentAt               DateTime?           @map("sent_at")
  receivedAt           DateTime?           @map("received_at")

  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId    String        @map("ingredient_id")
  ingredientName  String        @map("ingredient_name")
  unit            String
  qty             Float
  receivedQty     Float         @default(0) @map("received_qty")
  unitPrice       Int           @map("unit_price") // In agorot
  lineTotal       Int           @map("line_total")  // In agorot

  @@map("purchase_order_lines")
}

// ─────────────────────────────────────────────────────────────────────────────
// KitchenTask model (Phase 8 — Kitchen module)
// ─────────────────────────────────────────────────────────────────────────────

model KitchenTask {
  id                  String            @id @default(cuid())
  date                String            // YYYY-MM-DD
  status              KitchenTaskStatus @default(TODO)
  dish                Json              // { id, name, kashrut }
  qty                 Float
  unit                SaleUnit          @default(PORTION)
  earliestDepartureAt DateTime?         @map("earliest_departure_at")
  assigneeId          String?           @map("assignee_id")
  assignee            Json?             // { id, name }
  orders              Json              @default("[]") // [{ id, number, customerName, qty }]

  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@map("kitchen_tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
// Delivery model (Phase 9 — Deliveries & Driver logistics module)
// ─────────────────────────────────────────────────────────────────────────────

model Delivery {
  id                 String         @id @default(cuid())
  orderId            String         @map("order_id")
  orderNumber        Int            @map("order_number")
  customerName       String         @map("customer_name")
  customerPhone      String         @map("customer_phone")
  address            String
  lat                Float?
  lng                Float?
  driverId           String?        @map("driver_id")
  driverName         String?        @map("driver_name")
  sequence           Int?
  plannedDepartureAt DateTime?      @map("planned_departure_at")
  status             DeliveryStatus @default(UNASSIGNED)
  date               String         // YYYY-MM-DD
  startedAt          DateTime?      @map("started_at")
  completedAt        DateTime?      @map("completed_at")
  boxesCount         Int            @default(1) @map("boxes_count")
  notes              String?
  receiverName       String?        @map("receiver_name")
  signatureUrl       String?        @map("signature_url")
  photoUrl           String?        @map("photo_url")
  deliveryNotes      String?        @map("delivery_notes")
  checkedBoxes       Json           @default("[]") @map("checked_boxes")
  completionLat      Float?         @map("completion_lat")
  completionLng      Float?         @map("completion_lng")
  clientCompletedAt  DateTime?      @map("client_completed_at")

  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@map("deliveries")
}


