// Prisma schema — Catering Management System
// DB: PostgreSQL 16, managed by Prisma ORM
// Conventions: snake_case in DB, camelCase in JS (Prisma maps automatically)
// Money: all amounts stored as Int (agorot). No floats.
// IDs: cuid() — matches the API contract (§1.1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — kept in sync with packages/shared/src/enums.ts
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  OFFICE
  KITCHEN_MANAGER
  KITCHEN_STAFF
  DRIVER
}

enum DishCategory {
  STARTER
  MAIN
  SIDE
  SALAD
  DESSERT
  DRINK
}

enum Kashrut {
  MEAT
  DAIRY
  PARVE
}

enum SaleUnit {
  PORTION
  TRAY
  KG
  UNIT
}

enum OrderStatus {
  DRAFT
  QUOTE_SENT
  CONFIRMED
  IN_PRODUCTION
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CLOSED
  LOST
  CANCELLED
}

enum EventType {
  CELEBRATION
  BRIT
  BAR_MITZVAH
  CORPORATE
  SHABBAT
  OTHER
}

enum ServiceType {
  DELIVERY
  DELIVERY_AND_SERVING
  PICKUP
}

enum DiscountType {
  NONE
  FIXED
  PERCENT
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  CREDIT_CARD
  NET_30
}

// ─────────────────────────────────────────────────────────────────────────────
// User model (Week 1 — Auth & Users module)
// Fields: id, email, passwordHash, role, active
// Extra useful fields added now so seed/auth work correctly.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  active       Boolean  @default(true)
  phone        String?

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Password reset
  resetToken          String?   @unique @map("reset_token")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Dish model (Phase 4 — Dishes module)
// Fields: id, version, name, category, kashrut, unit, portionsPerUnit, price,
//         imageUrl, allergens, active, recipe, cost, timestamps
// ─────────────────────────────────────────────────────────────────────────────

model Dish {
  id              String       @id @default(cuid())
  version         Int          @default(1)
  name            String
  category        DishCategory
  kashrut         Kashrut
  unit            SaleUnit     @default(PORTION)
  portionsPerUnit Float        @default(1) @map("portions_per_unit")
  price           Int          // In agorot
  imageUrl        String?      @map("image_url")
  allergens       String[]     @default([])
  active          Boolean      @default(true)
  recipe          Json         @default("[]") // Recipe lines: [{ ingredientId, ingredientName, unit, qtyPerPortion }]
  cost            Json?        // Cost info: { perPortion, marginPercent }

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dishes")
}

// ─────────────────────────────────────────────────────────────────────────────
// Order model (Phase 5 — Orders module)
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id                 String      @id @default(cuid())
  number             Int         @default(autoincrement())
  status             OrderStatus @default(DRAFT)
  version            Int         @default(1)
  customerId         String      @map("customer_id")
  customer           Json        // { id, name, phone }
  event              Json        // Event: { id, title, type, startsAt, address, lat, lng, guests, kashrut, serviceType, notes }
  items              Json        @default("[]") // OrderItem[]: [{ id, dishId, dishName, category, unit, qty, unitPrice, priceOverridden, lineTotal, notes }]
  services           Json        @default("[]") // OrderService[]: [{ id, serviceId, name, qty, unitPrice, lineTotal }]
  pricing            Json        // Pricing: { discountType, discountValue, vatPercent, pricesIncludeVat, depositPercent, paymentTerms, validUntil }
  totals             Json        // Totals: { subtotal, discount, vat, total, deposit, paid, balance, perGuest }
  allowedTransitions OrderStatus[] @map("allowed_transitions")
  isLocked           Boolean     @default(false) @map("is_locked")
  latestQuoteVersion Int?        @map("latest_quote_version")
  createdById        String      @map("created_by_id")
  createdBy          Json        // { id, name }

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("orders")
}

